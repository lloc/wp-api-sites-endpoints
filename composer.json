{
    "name": "wp-api/wp-api-sites-endpoint",
    "type": "wordpress-plugin",
    "description": "Manage your WordPress sites in a multisite.",
    "homepage": "http://wp-api.org/",
    "license": "GPL2+",
    "authors": [
        {
            "name": "WP-API Team",
            "homepage": "http://wp-api.org/"
        }
    ],
    "support": {
        "issues": "https://github.com/WP-API/WP-API/issues",
        "forum": "https://wordpress.org/support/plugin/rest-api"
    },
    "require": {
        "php": ">=7.4",
        "composer/installers": "~2.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "3.13.2",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "extra": {
        "installer-name": "json-rest-api"
    },
    "scripts": {
        "format": "vendor/bin/phpcbf -ps .",
        "lint": "vendor/bin/phpcs -ps .",
        "phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "@php ./vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
